# Browser-safe values. The anon key is public by design; RLS protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The Gemini key must never be prefixed VITE_. It is set as a Supabase secret
# and read only inside the `compose` Edge Function:
#   supabase secrets set GEMINI_API_KEY=...
#   supabase secrets set GEMINI_MODEL=...
