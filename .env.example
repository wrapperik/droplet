# Copy this file to .env.local and fill it in. .env.local is git-ignored, and none of these start with VITE_,
# so none of them can reach the browser. Restart `npm run dev` after changing them.

# Your Gemini API key, from Google AI Studio (https://aistudio.google.com, "Get API key").
GEMINI_API_KEY=

# The model, pinned. The pitch only changes it after re-running the fixed test requests:
#   node --env-file=.env.local scripts/eval-compose.ts
# GEMINI_MODEL=gemini-3.8-flash

# Used instead when the main model's free daily quota is used up or it is overloaded (each model has its own quota).
# Default gemini-3.5-flash-lite. Set to "none" to turn the fallback off.
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# How hard the model thinks before it answers. Unset is the most careful and the slowest. Try "low" if replies feel slow.
# GEMINI_THINKING_LEVEL=low

# Compositions allowed per hour on this machine (default 60).
# COMPOSE_LIMIT_PER_HOUR=60

# Supabase, for sign-in and for keeping each founder's projects and documents. The URL and the publishable key (also called the anon key) are
# meant to be in the browser, which is why these two start with VITE_: what a founder can reach is decided by the row-level security in the
# database, not by hiding the key. NEVER put the secret (service role) key here or in any VITE_ variable. See docs/supabase-setup.md.
# With both empty the app runs on this device alone: no sign-in, and what is saved stays in this browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
