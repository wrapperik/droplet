# Copy this file to .env.local and fill it in. .env.local is git-ignored, and none of these start with VITE_,
# so none of them can reach the browser. Restart `npm run dev` after changing them.

# Your Gemini API key, from Google AI Studio (https://aistudio.google.com, "Get API key").
GEMINI_API_KEY=

# TEMPORARY STAND-IN: DeepSeek instead of Gemini. Set AI_PROVIDER=deepseek and DEEPSEEK_API_KEY (from https://platform.deepseek.com) and restart `npm run dev`.
# Every message is then answered by one DeepSeek model (DEEPSEEK_MODEL, default deepseek-flash). It cannot search the web and Advanced is not offered. It reads pictures (V4.1
# Flash takes images); a PDF is sent as a file block, which is a best guess, and if the API refuses it the model is told it could not read it. A text file always works. Leave AI_PROVIDER unset, or gemini, to go back. The GEMINI_* settings below are
# ignored while it is on. On the deployed function set the same names as secrets: npx supabase secrets set AI_PROVIDER=deepseek DEEPSEEK_API_KEY=...
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# Thinking is off by default, which is much faster. DEEPSEEK_THINKING=enabled turns it on (DEEPSEEK_REASONING_EFFORT: low, high or max).
# DEEPSEEK_THINKING=disabled

# Quick and Advanced. Every message is answered by Quick unless the founder chooses Advanced in the menu in the message bar, for the next
# message only. The models are pinned: the pitch only changes them after re-running the fixed test requests:
#   node --env-file=.env.local scripts/eval-compose.ts                      (Quick)
#   EVAL_MODE=advanced node --env-file=.env.local scripts/eval-compose.ts   (Advanced, which may search)
#
# Quick: a fast model that never searches and has no spare. Default gemini-3.5-flash-lite.
# GEMINI_BASE_MODEL=gemini-3.5-flash-lite
# How hard Quick thinks before it answers. Default low.
# GEMINI_BASE_THINKING=low
#
# Advanced: a stronger model that can search the web with Google Search. Default gemini-3.8-flash. When Google cannot answer with it (its free daily
# quota is used up, or it is overloaded) Quick answers instead, and that does not count against the founder. GEMINI_MODEL still works as another name.
# GEMINI_ADVANCED_MODEL=gemini-3.8-flash
# How hard Advanced thinks. Unset leaves it to the API, which is the most careful and the slowest. GEMINI_THINKING_LEVEL still works.
# GEMINI_ADVANCED_THINKING=low
#
# Advanced answers each founder may have in a day (a sliding 24 hours, default 10). On this machine they are counted in memory, so restarting the dev
# server starts the day again. 0 turns Advanced off. Each search counts against the key's free 5,000 searches a month. See docs/deploy.md.
# COMPOSE_ADVANCED_PER_DAY=10

# Compositions allowed per hour on this machine (default 60).
# COMPOSE_LIMIT_PER_HOUR=60

# Supabase, for sign-in and for keeping each founder's projects and documents. The URL and the publishable key (also called the anon key) are
# meant to be in the browser, which is why these two start with VITE_: what a founder can reach is decided by the row-level security in the
# database, not by hiding the key. NEVER put the secret (service role) key here or in any VITE_ variable. See docs/supabase-setup.md.
# With both empty the app runs on this device alone: no sign-in, and what is saved stays in this browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where the app asks the composer. Unset is right for almost everyone: in development it asks this dev server (/api/compose, which uses
# GEMINI_API_KEY above), and the deployed app asks the `compose` Supabase Edge Function. Set it to a function's address to try the deployed
# function from the dev server (the founder's token is sent when the address is on your Supabase project).
# VITE_COMPOSE_URL=https://your-project.supabase.co/functions/v1/compose
#
# The deployed function reads the same GEMINI_* names as SECRETS of the function, not from this file: see docs/deploy.md.
